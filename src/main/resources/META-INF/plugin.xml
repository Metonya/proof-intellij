<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.proofjava.plugin</id>
    <name>Proof</name>
    <vendor>proof-java</vendor>
    <description><![CDATA[
        <p>See which of your passing tests actually prove anything, inline as you code.</p>
        <p>Runs <a href="https://github.com/Metonya/proof-java">proof-java</a> against your project and shows
        its verdict directly in the editor: which lines are covered, which of the tests covering them have no
        real assertion, and which mutations nothing catches.</p>
    ]]></description>

    <!-- M0: platform-only dependency, no UI/actions/tool windows registered
         yet - this milestone's only goal is "runIde launches a blank
         plugin." Java-language-specific gating (editor/context menus,
         hover) is added in later milestones alongside the UI it belongs to,
         not here - `core` itself stays language-agnostic. -->
    <depends>com.intellij.modules.platform</depends>
    <!-- M6: the hover provider registers against
         `platform.backend.documentation.targetProvider`, which lives in
         `intellij.platform.lang.impl` (module id `com.intellij.modules.lang`)
         - bundled in every IntelliJ IDEA distribution, but declared
         explicitly per JetBrains' own recommended practice for plugins
         using lang-impl APIs (real examples: the Python plugin's own
         `RequirementDocumentationLinkHandler` registration). Not
         `com.intellij.modules.java` / `com.intellij.java` - no Java PSI
         dependency is added here, by design (see `hover/HoverContent.kt`). -->
    <depends>com.intellij.modules.lang</depends>

    <!-- M2: the extension point core.engine.Engine implementations plug
         into. core/engine-java are merged into this one plugin's jar
         (composedJar), not separate "content modules" - this is a plain
         internal strategy-pattern EP, not for third-party contributions. -->
    <!-- M6 (revised): a tab of the "Proof" tool window an engine
         contributes without core.ui.toolwindow ever importing
         engine-java directly - same "EP in core, implementation in
         engine-java" pattern as `engine` above. Replaces the earlier
         separate "Proof: Line to Tests" top-level tool window; real user
         feedback (a live runIde session, 2026-09-07) found two windows
         confusing where one, tabbed, is not. -->
    <extensionPoints>
        <extensionPoint name="engine" interface="dev.proofjava.intellij.core.engine.Engine" dynamic="true"/>
        <extensionPoint name="toolWindowTab" interface="dev.proofjava.intellij.core.ui.toolwindow.ProofToolWindowTab" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="dev.proofjava.intellij">
        <engine implementation="dev.proofjava.intellij.engine.java.JavaEngine"/>
        <toolWindowTab implementation="dev.proofjava.intellij.engine.java.ui.JavaLineTestsToolWindowTab"/>
        <toolWindowTab implementation="dev.proofjava.intellij.engine.java.ui.JavaMutationToolWindowTab"/>
    </extensions>

    <!-- M3: Quick Scan's own plumbing - project state, the gutter's
         reapply-on-new-editor listener, and the Coverage tool window. -->
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.proofjava.intellij.core.state.CoverageStateService"/>
        <projectService serviceImplementation="dev.proofjava.intellij.core.state.PerTestStateService"/>
        <projectService serviceImplementation="dev.proofjava.intellij.core.state.MutationStateService"/>
        <!-- Real user feedback (2026-09-07): none of this was reachable
             from IntelliJ's own Settings dialog. jarPath/diffMode/baseRef
             only - reportPath is still hardcoded (a real, disclosed,
             separate gap, see QuickScanAction.kt). -->
        <projectService serviceImplementation="dev.proofjava.intellij.core.settings.ProofSettingsState"/>
        <projectConfigurable instance="dev.proofjava.intellij.core.settings.ProofConfigurable" id="dev.proofjava.intellij.settings" displayName="Proof"/>
        <postStartupActivity implementation="dev.proofjava.intellij.core.startup.GutterReapplyActivity"/>
        <!-- Real user request (2026-09-07): a project reopen should show
             the last scan's results immediately, same as proof-vscode
             already does - it never did here until now. -->
        <postStartupActivity implementation="dev.proofjava.intellij.core.startup.RestoreLastScanActivity"/>
        <toolWindow id="Proof" anchor="right" factoryClass="dev.proofjava.intellij.core.ui.toolwindow.CoverageToolWindowFactory"/>
        <!-- M4 -->
        <statusBarWidgetFactory id="dev.proofjava.intellij.statusBar" implementation="dev.proofjava.intellij.core.ui.statusbar.CoverageStatusBarWidgetFactory"/>
        <projectViewNodeDecorator implementation="dev.proofjava.intellij.core.ui.projectview.CoverageFileDecorator"/>
        <!-- M6: raw (PsiFile, offset) hover - see hover/HoverContent.kt's
             own doc comment for why this EP and not a PSI-based one. -->
        <platform.backend.documentation.targetProvider implementation="dev.proofjava.intellij.engine.java.hover.CoverageHoverTargetProvider"/>
        <platform.backend.documentation.linkHandler implementation="dev.proofjava.intellij.engine.java.hover.CoverageHoverLinkHandler"/>
    </extensions>

    <!-- Icons via AllIcons.* (a real, supported plugin.xml `icon` attribute
         form - verified against real bundled plugin.xml examples in
         JetBrains/intellij-community, e.g. hg4idea's own actions), not
         custom SVGs: proof-vscode itself never assigned these four
         commands an icon either (checked its package.json - only
         Export/Settings/Install-Skill/Download-jar get one, via VS Code's
         built-in codicon font, and none of those four are in this set),
         so there is nothing to port here, only a genuine IntelliJ-side
         addition. Ordered Run Tests before Quick Scan - real user
         feedback (2026-09-07): you need a JaCoCo report before a scan can
         read one, so that's the natural first step. -->
    <actions>
        <group id="dev.proofjava.intellij.MainMenu" text="Proof" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="dev.proofjava.intellij.RunTests" class="dev.proofjava.intellij.core.actions.RunTestsAction" text="Run Tests" description="Run the project's own build tool with JaCoCo, then Quick Scan" icon="AllIcons.General.RunWithCoverage"/>
            <action id="dev.proofjava.intellij.QuickScan" class="dev.proofjava.intellij.core.actions.QuickScanAction" text="Quick Scan" description="Run proof-java and show coverage in the gutter and the Coverage view" icon="AllIcons.Actions.Search"/>
            <action id="dev.proofjava.intellij.DeepScan" class="dev.proofjava.intellij.core.actions.DeepScanAction" text="Deep Scan" description="Quick Scan plus per-test (L2) evidence - which test covers which line" icon="AllIcons.Actions.TraceInto"/>
            <action id="dev.proofjava.intellij.DeepScanWholeModule" class="dev.proofjava.intellij.core.actions.DeepScanWholeModuleAction" text="Deep Scan Whole Module (no diff)" description="Deep Scan every production class from the last Quick Scan, not just the ones the diff touched" icon="AllIcons.Actions.GroupByModule"/>
            <action id="dev.proofjava.intellij.ToggleCoverage" class="dev.proofjava.intellij.core.actions.ToggleCoverageAction" text="Toggle Coverage View" description="Show or hide coverage decorations without re-scanning" icon="AllIcons.Actions.ToggleVisibility"/>
            <!-- M7: mutation testing - never auto-triggered, always confirmed
                 first (runtime grows linearly with the target count). -->
            <action id="dev.proofjava.intellij.MutationForModule" class="dev.proofjava.intellij.core.actions.MutationForModuleAction" text="Mutation Testing (Module)" description="Run PIT mutation testing against the diff's changed production classes - can take a long time" icon="AllIcons.Actions.Lightning"/>
            <action id="dev.proofjava.intellij.MutationForModuleAll" class="dev.proofjava.intellij.core.actions.MutationForModuleAllAction" text="Mutation Testing (Module, No Diff)" description="Run PIT mutation testing against every production class from the last Quick Scan, not just the ones the diff touched" icon="AllIcons.Actions.RunAll"/>
        </group>
    </actions>
</idea-plugin>
